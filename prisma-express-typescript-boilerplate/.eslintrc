{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  // Thêm đoạn overrides này vào:
  "overrides": [
    {
      "files": ["src/tests/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}